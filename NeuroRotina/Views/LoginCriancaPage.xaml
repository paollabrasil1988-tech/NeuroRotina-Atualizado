<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:NeuroRotina.Views"
    x:Class="NeuroRotina.Views.LoginCriancaPage"
    Title="LOGIN DA CRIANÇA"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NeuroFundo}">

    <Grid RowDefinitions="Auto,*">
       
        <VerticalStackLayout
            Grid.Row="0"
            BackgroundColor="{StaticResource NeuroAzul}"
            Padding="20,24,20,24"
            Spacing="10">

            <!-- Cabeçalho com botão de voltar e logo -->
            <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                <Button
                    x:Name="btnVoltar"
                    Text="⟵"
                    FontSize="18"
                    WidthRequest="44"
                    HeightRequest="44"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    Clicked="BtnVoltar_Clicked" />

                <Image
                    Source="logo.png"
                    HeightRequest="200"
                    WidthRequest="200"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    Grid.Column="1" />
            </Grid>

        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="28,26"
                Spacing="14">

                <Label
                    Text="Login da criança"
                    Style="{StaticResource Rotulo}"
                    FontSize="22"
                    HorizontalOptions="Center" />

                <Label Text="Meu nome" Style="{StaticResource Rotulo}" />
                <Border Style="{StaticResource Campo}">
                    <Entry x:Name="txtNome" Placeholder="Nome ou apelido" />
                </Border>

                <Label Text="Meu PIN" Style="{StaticResource Rotulo}" />
                <Border Style="{StaticResource Campo}">
                    <Entry
                        x:Name="txtPin"
                        Placeholder="PIN de 4 dígitos"
                        Keyboard="Numeric"
                        MaxLength="4"
                        IsPassword="True" />
                </Border>

                <Button
                    Text="Entrar"
                    Style="{StaticResource BotaoDestaque}"
                    Margin="0,12,0,0"
                    Clicked="BtnEntrar_Clicked" />

                <Label x:Name="lblMensagem" Style="{StaticResource TextoMensagem}" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
