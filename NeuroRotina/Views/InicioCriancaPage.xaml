<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:NeuroRotina.Views"
    x:Class="NeuroRotina.Views.InicioCriancaPage"
    Title="NEUROROTINA"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NeuroFundo}">

    <Grid RowDefinitions="Auto,*">

        <v:CabecalhoView
            x:Name="cabecalho"
            Grid.Row="0"
            Titulo="Olá!"
            MostrarVoltar="False" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="28,34"
                Spacing="24">

                <Button
                    Text="🗓  Minhas rotinas"
                    Style="{StaticResource BotaoPrimario}"
                    FontSize="26"
                    HeightRequest="110"
                    Clicked="BtnAtividades_Clicked" />

                <Button
                    Text="💬  Necessidades"
                    Style="{StaticResource BotaoDestaque}"
                    FontSize="26"
                    HeightRequest="110"
                    Clicked="BtnNecessidades_Clicked" />

                <Button
                    Text="Sair"
                    Style="{StaticResource BotaoSecundario}"
                    Margin="0,30,0,0"
                    Clicked="BtnSair_Clicked" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
