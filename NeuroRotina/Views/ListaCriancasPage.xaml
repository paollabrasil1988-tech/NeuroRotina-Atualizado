<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:NeuroRotina.Views"
    x:Class="NeuroRotina.Views.ListaCriancasPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NeuroFundo}">

    <Grid RowDefinitions="Auto,*">

        <v:CabecalhoView Grid.Row="0" Titulo="Minhas Crianças" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="24,24"
                Spacing="16">

                <VerticalStackLayout
                    x:Name="ListaCriancas"
                    Spacing="16" />

                <Button
                    Text="Cadastrar nova criança"
                    Style="{StaticResource BotaoPrimario}"
                    Clicked="BtnNovaCrianca_Clicked" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
