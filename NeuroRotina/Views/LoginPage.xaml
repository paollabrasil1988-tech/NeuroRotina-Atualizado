<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.LoginPage"
    Title="LOGIN"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NeuroFundo}">

    <Grid RowDefinitions="Auto,*">

        <!-- Topo azul com o logo -->
        <VerticalStackLayout
            Grid.Row="0"
            BackgroundColor="{StaticResource NeuroAzul}"
            Padding="20,24,20,24"
            Spacing="10">

            <Image
                Source="logo.png"
                HeightRequest="200"
                WidthRequest="200"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

           

        </VerticalStackLayout>

        <!-- Campos de login -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="28,26"
                Spacing="14">

                <Label
                    Text="Login do adulto"
                    Style="{StaticResource Rotulo}"
                    FontSize="22"
                    HorizontalOptions="Center" />

                <Border Style="{StaticResource Campo}">
                    <Entry
                        x:Name="txtEmail"
                        Placeholder="E-mail"
                        Keyboard="Email" />
                </Border>

                <Border Style="{StaticResource Campo}">
                    <Entry
                        x:Name="txtSenha"
                        Placeholder="Senha"
                        IsPassword="True" />
                </Border>

                <Button
                    Text="Entrar"
                    Style="{StaticResource BotaoPrimario}"
                    Clicked="BtnEntrar_Clicked" />

                <Button
                    Text="Criar conta"
                    Style="{StaticResource BotaoSecundario}"
                    Clicked="BtnCriarConta_Clicked" />

                <Label
                    Text="ou"
                    Style="{StaticResource TextoCorpo}"
                    HorizontalOptions="Center" />

                <Button
                    Text="Entrar como criança"
                    Style="{StaticResource BotaoDestaque}"
                    Clicked="BtnEntrarComoCrianca_Clicked" />

                <Label
                    x:Name="lblMensagem"
                    Style="{StaticResource TextoMensagem}" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>