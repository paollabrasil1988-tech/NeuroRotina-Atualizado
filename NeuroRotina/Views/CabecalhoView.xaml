<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.CabecalhoView">

    <!-- Faixa azul do topo, igual ao Figma: título serifado centralizado e botão de voltar -->
    <Grid
        BackgroundColor="{StaticResource NeuroAzul}"
        HeightRequest="96"
        Padding="14,0">

        <Border
            x:Name="btnVoltar"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            WidthRequest="46"
            HeightRequest="46"
            BackgroundColor="{StaticResource NeuroAzulClaro}"
            StrokeThickness="0"
            SemanticProperties.Description="Voltar">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Voltar_Tapped" />
            </Border.GestureRecognizers>

            <Label
                Text="←"
                TextColor="White"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <Label
            x:Name="lblTitulo"
            Style="{StaticResource TituloPagina}"
            HorizontalOptions="Center"
            Margin="56,0" />
    </Grid>
</ContentView>
