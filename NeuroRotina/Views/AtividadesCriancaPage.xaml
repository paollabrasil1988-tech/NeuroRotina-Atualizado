<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:NeuroRotina.Views"
    x:Class="NeuroRotina.Views.AtividadesCriancaPage"
    Title="ROTINAS"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NeuroFundo}">

    <Grid RowDefinitions="Auto,*">

        <v:CabecalhoView Grid.Row="0" Titulo="Minhas Rotinas" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="22,20"
                Spacing="16">

                <Label
                    x:Name="lblHoje"
                    Style="{StaticResource Rotulo}"
                    FontSize="22"
                    HorizontalOptions="Center" />

                <VerticalStackLayout
                    x:Name="ListaAtividades"
                    Spacing="16" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
