<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.LogoView">

    <!--
        ESPAÇO DO LOGO
        Para colocar o logo: copie a imagem para a pasta Resources/Images com o
        nome  logo.png  (minúsculo). Ela aparece sozinha por cima deste quadro.
    -->
    <Grid x:Name="areaLogo" WidthRequest="160" HeightRequest="160">

        <Border
            BackgroundColor="White"
            Stroke="{StaticResource NeuroBorda}"
            StrokeThickness="2"
            StrokeDashArray="5,4">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>

            <Label
                Text="SEU LOGO&#10;AQUI"
                TextColor="Gray"
                FontSize="15"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <Image
            x:Name="imgLogo"
            Source="logo.png"
            Aspect="AspectFit"
            Margin="8" />
    </Grid>
</ContentView>
